{% set title = status_text|trans %}
{% extends '@website-theme/base.html.twig' %}

{% block main %}
    <div class="py-8 px-4 mx-auto pt-5">
        <div class="mx-auto max-w-screen-sm text-center">
            <h1 class="mb-4 fs-1 fw-bolder">{{ status_code }}</h1>
            <p class="mb-4 fs-3 fw-bold">{{ status_text|trans }}</p>
            <p class="mb-4 fs-4">{% trans %}Sorry, an unknown error occured.{% endtrans %}</p>
            <a href="{{ path('homepage') }}" class="btn btn-secondary btn-footer">{% trans %}Back to Homepage{% endtrans %}</a>
        </div>   
    </div>
{% endblock %}