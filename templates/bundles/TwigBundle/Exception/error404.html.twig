{% set title = 'Page not found'|trans %}
{% extends '@website-theme/base.html.twig' %}

{% block main %}
    <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6 pt-5">
        <div class="mx-auto max-w-screen-sm text-center">
            <h1 class="mb-4 fs-1 fw-bolder">404</h1>
            <p class="mb-4 fs-3 fw-bold">{% trans %}Page not found{% endtrans %}</p>
            <p class="mb-4 fs-4">{% trans %}Sorry, we can't find the page you requested.{% endtrans %}</p>
            <a href="{{ path('homepage') }}" class="btn btn-secondary btn-footer">{% trans %}Back to Homepage{% endtrans %}</a>
        </div>   
    </div>
{% endblock %}