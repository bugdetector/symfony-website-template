{% extends 'base.html.twig' %}

{% block body %}
	<div class='{{ page.slug != 'home' ? 'pt-5' }}'>
		{% if page.slug == 'home' %}
			<section class="slider">
				<div class="container-lg">
					<div class="slider-bg mb-5">
						<div class="slider-head">
							<div class="slider-text">
								<div class="slider-text-head">
									<h1>SOFTWARE DESIGN AND DEVELOPMENT PARTNER</h1>
									<p>Welcome to Ai Web Solutions Ltd, your CMS, CRM, and Integration Specialists.</p>
								</div>
								<div class="slider-text-btn gap-x-5 ">
									<a class="btn btn-orange" href="#contact-form">Let’s discuss your project</a>
									<a class="btn btn-tra" href="#contact-form">What WE do</a>
								</div>
							</div>
							<div class="swiper swiper-home col-lg-6 col-12" data-slides-per-view="1" data-space-between="0" data-centered-slides="true" data-navigation='{"nextEl":".blog-btn-next","prevEl": ".blog-btn-prev"}' data-autoplay='{"delay":2000}' data-speed="1000" data-loop="true">
								<div class="swiper-wrapper">
									{% for slider in page.sliderItems %}
										<div class="swiper-slide w-fuk">
											<div class="blog-slider-bg">
												<div class="blog-slider-img">
													<img class="img-fluid slider-img w-100" alt="{{ slider.title }}" src="{{ upload_asset(slider.sliderImage.filePath) }}">
												</div>
												<div class="blog-slider-item">
													<div class="blog-slider-head">
														<h1>{{ slider.title }}</h1>
													</div>
													<div class="blog-slider-flex">
														<div class="blog-slider-left">
															<a class="blog-slider-link" href="{{ slider.url }}">More</a>
														</div>
													</div>
												</div>
											</div>
										</div>
									{% endfor %}
								</div>
								<div class="blog-swiper-btn">
									<button class="blog-btn-prev">
										<svg data-v-f3438552="" width="19" height="16" viewbox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path data-v-f3438552="" d="M0.292892 7.29289C-0.0976315 7.68342 -0.0976314 8.31658 0.292893 8.70711L6.65686 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711C8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8L8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107 0.928933C7.68054 0.538409 7.04738 0.538409 6.65685 0.928933L0.292892 7.29289ZM19 7L1 7L1 9L19 9L19 7Z" fill="black"></path>
										</svg>
									</button>
									<button class="blog-btn-next">
										<svg data-v-f3438552="" width="19" height="16" viewbox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path data-v-f3438552="" d="M0.292892 7.29289C-0.0976315 7.68342 -0.0976314 8.31658 0.292893 8.70711L6.65686 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711C8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8L8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107 0.928933C7.68054 0.538409 7.04738 0.538409 6.65685 0.928933L0.292892 7.29289ZM19 7L1 7L1 9L19 9L19 7Z" fill="black"></path>
										</svg>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		{% else %}
			{% if page.sliderItems.count > 0 %}
				<section class="blog-slider mb-3">
					<div class="container-lg">
						<div class="swiper swiper-container" data-slides-per-view="1" data-space-between="0" data-centered-slides="true" data-navigation='{"nextEl":".blog-btn-next","prevEl": ".blog-btn-prev"}' data-autoplay='{"delay":2000}' data-speed="1000" data-loop="true">
							<div class="swiper-wrapper">
								{% for slider in page.sliderItems %}
									<div class="swiper-slide">
										<div class="blog-slider-bg">
											<div class="blog-slider-img">
												<img class="img-fluid" alt="{{ slider.title }}" src="{{ upload_asset(slider.sliderImage.filePath) }}">
											</div>
											<div class="blog-slider-item">
												<div class="blog-slider-head">
													<h1>{{ slider.title }}</h1>
												</div>
												{% if slider.url %}
													<div class="blog-slider-flex">
														<div class="blog-slider-left">
															<a class="blog-slider-link" href="{{ slider.url }}">DAHA FAZLA</a>
														</div>
													</div>
												{% endif %}
											</div>
										</div>
									</div>
								{% endfor %}
							</div>
							<div class="blog-swiper-btn">
								<button class="blog-btn-prev">
									<svg data-v-f3438552="" width="19" height="16" viewbox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path data-v-f3438552="" d="M0.292892 7.29289C-0.0976315 7.68342 -0.0976314 8.31658 0.292893 8.70711L6.65686 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711C8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8L8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107 0.928933C7.68054 0.538409 7.04738 0.538409 6.65685 0.928933L0.292892 7.29289ZM19 7L1 7L1 9L19 9L19 7Z" fill="black"></path>
									</svg>
								</button>
								<button class="blog-btn-next">
									<svg data-v-f3438552="" width="19" height="16" viewbox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path data-v-f3438552="" d="M0.292892 7.29289C-0.0976315 7.68342 -0.0976314 8.31658 0.292893 8.70711L6.65686 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711C8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8L8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107 0.928933C7.68054 0.538409 7.04738 0.538409 6.65685 0.928933L0.292892 7.29289ZM19 7L1 7L1 9L19 9L19 7Z" fill="black"></path>
									</svg>
								</button>
							</div>
						</div>
					</div>
				</section>
			{% endif %}
		{% endif %}
		{% if page.boxItems.count > 0 %}
			<div class="container">
				<div class="d-flex flex-wrap justify-content-center">
					{% for box in page.boxItems %}
						<div class="col-md-2 col-12 p-3">
							<div class="card bg-dark text-white mt-3 h-100">
								<img class="card-img w-100 h-100 object-cover" src="{{ box.image ? upload_asset(box.image.filePath) : "/assets/logo.png" }}" alt="{{ box.title }}">
								<div class="card-img-overlay" style="top: unset;">
									<a href="{{ box.url }}" class="card-title text-decoration-none">{{ box.title }}</a>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}

		{{ include(template_from_string(page.body ?? '')) }}
		{% if page.accordionItems.count > 0 %}
			<div class="container mb-3">
				<div class="accordion" id="page-accordion">
					{% for index, accordion in page.accordionItems %}
						<div class="accordion-item">
							<h2 class="accordion-header">
								<button class="accordion-button {{ index != 0 ? 'collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-{{ index }}">
									{{ accordion.title }}
								</button>
							</h2>
							<div id="accordion-{{ index }}" class="accordion-collapse collapse {{ index == 0 ? 'show' }}" data-bs-parent="#page-accordion">
								<div class="accordion-body visible">
									{{ accordion.body|raw }}
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}
		{% if page.galleryItems.count > 0 %}
			<div class='container'>
				<div class='row'>
					{% for file in page.galleryItems %}
						<div class='col-lg-3 col-md-4 col-sm-6 mb-3'>
							<a href="{{ upload_asset(file.filePath) }}" class="glightbox">
								<img src="{{ upload_asset(file.filePath) }}" class="img-fluid" alt="{{ file.fileName }}">
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
