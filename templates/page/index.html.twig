{% extends 'base.html.twig' %}

{% block body %}
	<div
		class="page-content-type-{{ page.contentType.slug }} page-{{ page.slug }}">
		{# Slider Section #}
		{% if page.sliderItems|length > 0 %}
			<div class="swiper" data-controller="swiper" data-slides-per-view="1" data-speed="1000" data-loop="true" data-autoplay='{"delay":3000}' data-space-between="20" data-navigation='{"nextEl":"#page-slider-next", "prevEl":"#page-slider-prev"}' data-pagination='{"el":".swiper-pagination",  "clickable":true}'>
				<div class="swiper-wrapper">
					{% for slider in page.sliderItems %}
						<div class="swiper-slide relative overflow-hidden">
							<img class="w-full object-cover max-h-[500px]" alt="{{ slider.title }}" src="{{ upload_asset(slider.sliderImage.filePath) }}"/>
							<a href="{{ slider.url }}" class="absolute inset-0 z-10" tabindex="-1" aria-label="{{ slider.title }}"></a>
							<div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-base-200/80 to-transparent p-6 flex flex-col gap-2 z-20 pointer-events-none">
								<h1 class="text-2xl font-bold text-base-100">{{ slider.title }}</h1>
								<span class="btn btn-primary btn-sm w-max pointer-events-auto relative z-30">{% trans %}Details{% endtrans %}</span>
							</div>
						</div>
					{% endfor %}
				</div>
				<div class="swiper-pagination" style="--swiper-pagination-color: var(--color-white); --swiper-pagination-bullet-inactive-color: var(--color-gray-300)"></div>
				<!-- Navigation Buttons -->
				<div class="absolute inset-y-0 z-10 left-0 flex items-center">
					<button id="page-slider-prev" class="btn btn-circle btn-light !bg-white !dark:bg-gray-800 ms-2">
						<i class="i-tabler-arrow-left text-light text-2xl"></i>
					</button>
				</div>
				<div class="absolute inset-y-0 z-10 right-0 flex items-center">
					<button id="page-slider-next" class="btn btn-circle btn-light !bg-white !dark:bg-gray-800 me-2">
						<i class="i-tabler-arrow-right text-light text-2xl"></i>
					</button>
				</div>
			</div>
		{% endif %}

		{# Box Items Section #}
		{% if page.boxItems.count > 0 %}
			<div class="flex flex-wrap justify-center gap-6 mb-8">
				{% for box in page.boxItems %}
					<div class="w-full sm:w-1/2 md:w-1/4 lg:w-1/6 p-2">
						<div class="card bg-base-200 shadow-xl h-full">
							<figure class="h-32 overflow-hidden"><img class="object-cover w-full h-full" src="{{ box.image ? upload_asset(box.image.filePath) : '/assets/logo.png' }}" alt="{{ box.title }}"/></figure>
							<div class="card-body p-4 flex flex-col justify-end">
								<a href="{{ box.url }}" class="card-title text-lg hover:underline after:absolute after:inset-0">{{ box.title }}</a>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		{% endif %}

		<div class="max-w-3xl mx-auto my-8 card bg-base-100 shadow p-6 prose prose-base md:prose-lg">
			{{ include(template_from_string(page.body ?? '')) }}
		</div>

		{# Accordion Section #}
		{% if page.accordionItems|length > 0 %}
			<div class="max-w-2xl mx-auto mb-8">
				<div class="join join-vertical w-full">
					{% set accordionGroup = 'page-accordion-' ~ random() %}
					{% for index, accordion in page.accordionItems %}
						<div class="collapse collapse-arrow join-item border border-base-300">
							<input type="radio" name="{{ accordionGroup }}" class="collapse-toggle" {% if index == 0 %} checked="checked" {% endif %}/>
							<div class="collapse-title text-lg font-medium">{{ accordion.title }}</div>
							<div class="collapse-content">
								{{ accordion.body|raw }}
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}

		{# Gallery Section #}
		{% if page.galleryItems.count > 0 %}
			<div class="flex flex-wrap justify-center gap-6 mb-8">
				{% for file in page.galleryItems %}
					<div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/4 p-2">
						<a href="{{ upload_asset(file.filePath) }}" class="block glightbox">
							<img src="{{ upload_asset(file.filePath) }}" class="rounded-box w-full h-48 object-cover" alt="{{ file.fileName }}"/>
						</a>
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>

	{{ component('website-contact-form') }}
{% endblock %}
