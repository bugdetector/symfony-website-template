{% set action = action is defined ? action : null %}
<tr id="contact_form_{{ contact.id }}" class='{{ action ? ' action-' ~ action }}'>
	<td class="px-6 py-3 flex gap-2">
		{% if action != 'remove' %}
			<a class="btn btn-sm btn-icon btn-clear btn-primary" href="{{ path('app_admin_contact_form_edit', {'id': contact.id}) }}">
				<i class="ki-outline ki-notepad-edit"></i>
			</a>
			{% if action == null %}
				<form method="post" action="{{ path('app_admin_contact_form_delete', {'id': contact.id}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
					{% set modalId = 'delete-modal-' ~ contact.id %}
					<button type='button' class="btn btn-sm btn-icon btn-clear btn-danger" role='button' data-modal-toggle="#{{ modalId }}">
						<i class="ki-outline ki-trash"></i>
					</button>
					{% include theme.themeDirectory ~ "/partials/_delete_modal.html.twig" with {modalId: modalId, objectName: "Contact Form"|trans} %}
				</form>
			{% endif %}
		{% endif %}
	</td>
	<td class="px-6 py-3">{{ contact.id }}</td>
	<td class="px-6 py-3">{{ contact.name }}</td>
	<td class="px-6 py-3">{{ contact.email }}</td>
    <td class="px-6 py-3">{{ contact.phone }}</td>
	<td class='px-6 py-3 text-nowrap'>
		<time>{{ contact.createdAt|format_datetime() }}</time>
	</td>
	<td class='px-6 py-3 text-nowrap'>
		<time>{{ contact.updatedAt|format_datetime() }}</time>
	</td>
</tr>
