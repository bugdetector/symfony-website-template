{% extends 'base.html.twig' %}

{% block backLink %}
	<a href="{{ path('app_admin_contact_form_index') }}" class="btn btn-outline">
		<i class="i-tabler-chevron-left"></i>
		{% trans %}Back{% endtrans %}
	</a>
{% endblock %}

{% block body %}
    <div class="flex flex-wrap">
        <div class="md:w-9/12 w-full">
            {{ component('LiveContactFormComponent', {initialFormData: contact_form}) }}
        </div>
        <div class="md:w-3/12 w-full">
            <div class='md:p-3 p-0'>
                {{ include('admin/contact_form/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
