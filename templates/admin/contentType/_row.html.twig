{% set action = action is defined ? action : null %}
<tr id="contentType_{{ object.id }}" class='{{ action ? ' action-' ~ action }}'>
    {% if bulkRemoveAllowed is defined and bulkRemoveAllowed %}
        <td>
            <input type="checkbox" data-model="bulkSelectIds[]" value="{{ object.id }}" {{ object.id in this.bulkSelectIds ? 'checked' }} class="toggle toggle-primary mr-2 select-all"/>
        </td>
    {% else %}
        <td></td>
    {% endif %}
    <td class="px-6 py-3">
        <div class="flex gap-2">
            {% if action != 'remove' %}
                <button class="btn btn-sm btn-outline" data-controller="modal" data-modal-target-modal-value="content-type-modal-form" data-action="live#emit" data-live-event-param="setFormData" data-live-object-id-param="{{ object.id }}">
                    <i class="i-tabler-edit text-lg"></i>
                </button>
                {% if action == null %}
					<form data-action="live#action" data-live-action-param="remove" data-live-entity-ids-param="[{{ object.id }}]" data-live-object-name-param="Content Type">
						{% set modalId = 'delete-modal-' ~ object.id %}
						<button type='button' class="btn btn-sm btn-error btn-outline" data-controller="modal" data-modal-target-modal-value="{{ modalId }}">
							<i class="i-tabler-trash text-lg"></i>
						</button>
						{% include theme.themeDirectory ~ "/partials/_delete_modal.html.twig" with {modalId: modalId, objectName: "Content Type"|trans} %}
					</form>
                {% endif %}
            {% endif %}
        </div>
    </td>
    <td class="px-6 py-3">{{ object.id }}</td>
    <td class="px-6 py-3">{{ object.name }}</td>
    <td class="px-6 py-3">
        <div class="badge badge-outline">{{ object.slug }}</div>
    </td>
    <td class='px-6 py-3 text-nowrap'>
        <time>{{ object.createdAt|format_datetime() }}</time>
    </td>
    <td class='px-6 py-3 text-nowrap'>
        <time>{{ object.updatedAt|format_datetime() }}</time>
    </td>
</tr>
