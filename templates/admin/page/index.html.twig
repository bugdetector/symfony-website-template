{% extends 'base.html.twig' %}

{% block actions %}
	<div class="container-fluid flex md:justify-end items-center my-3 gap-5">
		{% if page is not defined or not page %}
			<button type="button" class="btn btn-primary btn-sm" data-modal-toggle="#create-page-modal">
				<span class="flex justify-center items-center">
					<span class="ki-solid ki-plus-circle text-md me-2"></span>
					{% trans %}Add New Page{% endtrans %}
				</span>
			</button>
		{% endif %}

		{% if page is defined and page.id %}
			{% if page.contentType.slug == 'static-page' %}
				<a href='{{ path('app_page_static_view', {'slug': page.slug}) }}' target="_blank" class="btn btn-info btn-sm">
					<span class="flex justify-center items-center">
						<span class="ki-solid ki-eye text-md me-2"></span>
						{% trans %}View Page{% endtrans %}
					</span>
				</a>
			{% else %}
				<a href='{{ path('app_page_view', {contentTypeSlug: page.contentType.slug, 'slug': page.slug}) }}' target="_blank" class="btn btn-info btn-sm">
					<span class="flex justify-center items-center">
						<span class="ki-solid ki-eye text-md me-2"></span>
						{% trans %}View Page{% endtrans %}
					</span>
				</a>
			{% endif %}
		{% endif %}
	</div>
{% endblock %}

{% block body %}
	{{ component('PagesSearchComponent', {listTopic: 'pages'}) }}

	{% include "admin/page/create_page_modal.twig" with {modalId: 'create-page-modal'} %}
{% endblock %}
