<div {{ attributes }}>
    {{ include(theme.themeDirectory ~ '/partials/_flash_messages.html.twig') }}
    <h3 class="text-lg font-bold">
        {% if not this.initialFormData or not this.initialFormData.id  %}
            {% trans %}Add New Menu{% endtrans %}
        {% elseif this.initialFormData %}
            {% trans with {'{name}': this.initialFormData.name } %}Edit Menu: {name}{% endtrans %}
        {% endif %}
    </h3>
    {% if initialFormData.id %}
        {% if initialFormData.id %}
            <div class="tabs tabs-box tabs-lg">
                {% for localeObj in locales() %}
                    {% set is_active = (this.locale ?: this.defaultLocale) == localeObj.code %}
                    {% set is_rtl = localeObj.code in ['ar', 'fa', 'he'] %}
                    <input type="radio" data-model="locale" class="tab {{ is_active ? 'tab-active' : '' }}" value="{{ localeObj.code }}" aria-label="{{ localeObj.name|default(localeObj.code) }}" />
                {% endfor %}
            </div>
        {% endif %}
        <div class='mb-3'>
            <label class='font-bold'>{% trans %}created_at{% endtrans %}</label>
            <div>{{ initialFormData.createdAt|format_datetime('full', 'short') }}</div>
        </div>
        <div class='mb-3'>
            <label class='font-bold'>{% trans %}updated_at{% endtrans %}</label>
            <div>{{ initialFormData.updatedAt|format_datetime('full', 'short') }}</div>
        </div>
    {% else %}
        <div class="tabs tabs-box tabs-lg">
            {% set localeObj = locales()[this.defaultLocale] %}
            {% set is_active = (this.locale ?: this.defaultLocale) == localeObj.code %}
            {% set is_rtl = localeObj.code in ['ar', 'fa', 'he'] %}
            <input type="radio" data-model="locale" class="tab {{ is_active ? 'tab-active' : '' }}" value="{{ localeObj.code }}" aria-label="{{ localeObj.name|default(localeObj.code) }}" />
        </div>
    {% endif %}
    {{ form_start(form, {'attr': {'class': 'py-4'}}) }}
    {{ form_widget(form) }}
    <div class="modal-action">
        <button type="submit" class="btn btn-success btn-soft hover:text-base-100" data-loading="addAttribute(disabled)">
            <i class="i-tabler-check text-xl"></i>
            {% trans %}Save{% endtrans %}
        </button>
    </div>
    {{ form_end(form) }}

</div>
