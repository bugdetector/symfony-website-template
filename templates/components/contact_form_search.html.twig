{% extends theme.themeDirectory ~ "/partials/_datatable.html.twig" %}

{% block rows %}
	{% for contact in pagination %}
		{% include "admin/contact_form/contact_row.html.twig" with {contact} %}
	{% else %}
		<tr>
			<td colspan="6" class="px-6 py-3">{{ 'No Result Found'|trans }}</td>
		</tr>
	{% endfor %}
{% endblock %}
