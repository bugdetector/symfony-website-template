<header id="header" class="header">
	<div class="header-wrap container-lg">
		<a href="{{ path('homepage') }}" class="header-logo">
			<img src="{{ asset('assets/logo.png') }}" />
		</a>
		<div class="header-nav">
			<ul class="header-nav-list">
				{% for item in this.hierarchy() %}
					<li class="header-nav-item">
						{% if item.children.count > 0 %}
							<div class="main-nav-box">
								<div class="main-sub-menu">
									<div class="main-sub-left-info">
										<h1>{{ item.getExpandTitle() }}</h1>
										<p>{{ item.getExpandDescription() }}</p>
									</div>
									<div class="main-sub-list-grid container-lg">
										{% for child in item.children %}
											<div class="main-sub-grid-item">
												<a href="{{ child.url }}" class="main-sub-title-link sub-title-link-box">
													{{ child.title }}
												</a>
											</div>
										{% endfor %}
									</div>
								</div>
							</div>
						{% endif %}
						{% if item.children.count > 0 %}
							<a class="main-nav-link">
								<span class="main-nav-link-text sub-title-link-box">
									{{ item.title }}
									<span class="main-nav-link-icon"></span>
								</span>
							</a>
						{% else %}
							<a href="{{ item.url }}" class="main-nav-link">
								<span class="main-nav-link-text sub-title-link-box">
									{{ item.title }}
								</span>
							</a>
						{% endif %}

					</li>
				{% endfor %}
				<li class="header-nav-item header-btn mt-3">
					<a href="#contact-form" class="main-nav-link main-nav-mono">
						<span class="main-nav-link-text">
							İletişime geçin
						</span>
					</a>
				</li>
			</ul>
		</div>
		<button class="header-burger"></button>
	</div>
	<div class="header-overlay"></div>
	<div id="header-process" class="header-process-bar"></div>
</header>
