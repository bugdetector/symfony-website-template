<section id="contact-form" class="py-10 bg-base-100" {{ attributes }}>
	{{ include(theme.themeDirectory ~ '/partials/_flash_messages.html.twig') }}
	<div class="max-w-3xl mx-auto bg-base-200 rounded-box shadow-lg p-8">
		<h2 class="text-2xl font-bold mb-2">{% trans %}Contact us{% endtrans %}</h2>
		<p class="mb-6 text-base-content/80">
			{% trans %}Have a question? Fill out the form below and we’ll get back to you as soon as possible.{% endtrans %}
		</p>
		{{ form_start(form) }}
		{{ form_errors(form) }}
		<div class="flex flex-col gap-4">
			<label class="form-control w-full">
				<span class="label-text mb-1">{{ field_label(form.email) }}*</span>
				<input id="contact-email" name="{{ field_name(form.email) }}" value="{{ field_value(form.email) }}" class="input input-bordered w-full" type="email" placeholder="{{ field_label(form.email) }}">
				<span class="text-error text-xs mt-1">{{ form_errors(form.email) }}</span>
			</label>
			<label class="form-control w-full">
				<span class="label-text mb-1">{{ field_label(form.phone) }}*</span>
				<input id="contact-phone" name="{{ field_name(form.phone) }}" value="{{ field_value(form.phone) }}" class="input input-bordered w-full" type="tel" placeholder="{{ field_label(form.phone) }}">
				<span class="text-error text-xs mt-1">{{ form_errors(form.phone) }}</span>
			</label>
			<label class="form-control w-full">
				<span class="label-text mb-1">{{ field_label(form.name) }}*</span>
				<input id="contact-name" name="{{ field_name(form.name) }}" value="{{ field_value(form.name) }}" class="input input-bordered w-full" type="text" placeholder="{{ field_label(form.name) }}">
				<span class="text-error text-xs mt-1">{{ form_errors(form.name) }}</span>
			</label>
			<label class="form-control w-full">
				<span class="label-text mb-1">{{ field_label(form.message) }}*</span>
				<textarea id="contact-message" name="{{ field_name(form.message) }}" class="textarea textarea-bordered w-full min-h-[120px]" placeholder="{{ field_label(form.message) }}">{{ field_value(form.message) }}</textarea>
				<span class="text-error text-xs mt-1">{{ form_errors(form.message) }}</span>
			</label>
			<div class="text-xs text-base-content/60">
				{% trans %}By submitting this form, I consent to the use of my personal data as described in the privacy policy.{% endtrans %}
			</div>
			<button type="submit" class="btn btn-primary w-full mt-2">{% trans %}Send Message{% endtrans %}</button>
		</div>
		{{ form_end(form) }}
	</div>
</section>
