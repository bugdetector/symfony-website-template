<div class="row">
	<div class="col-md-12 text-center">
		<nav class="pagination-nav">
			{% if current == 0 %}
				{% set current = 1 %}
				{% set last = 1 %}
			{% endif %}
			<ul class="pagination">
				{% if previous is defined %}
					<li class="page-item">
						<a class="page-link page-link-prev " href="{{ path(route, query|merge({(pageParameterName): previous})) }}" aria-label="Previous">
							<span aria-hidden="true">
								<svg data-v-f3438552="" width="19" height="16" viewbox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path data-v-f3438552="" d="M0.292892 7.29289C-0.0976315 7.68342 -0.0976314 8.31658 0.292893 8.70711L6.65686 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711C8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8L8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107 0.928933C7.68054 0.538409 7.04738 0.538409 6.65685 0.928933L0.292892 7.29289ZM19 7L1 7L1 9L19 9L19 7Z" fill="black"></path>
								</svg>
							</span>
						</a>
					</li>
				{% endif %}
				{% for page in pagesInRange %}
					{% if page != 0 %}
						{% if page != current %}
							<li class="page-item">
								<a class="page-link" href="{{ path(route, query|merge({(pageParameterName): page})) }}">{{ page }}</a>
							</li>
						{% else %}
							<li class="page-item">
								<span class="page-link page-active">{{page}}</span>
							</li>
						{% endif %}
					{% endif %}
				{% endfor %}
				{% if next is defined %}
					<li class="page-item">
						<a class="page-link page-link-next" href="{{ path(route, query|merge({(pageParameterName): next})) }}" aria-label="Next">
							<span aria-hidden="true">
								<svg data-v-f3438552="" width="19" height="16" viewbox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path data-v-f3438552="" d="M0.292892 7.29289C-0.0976315 7.68342 -0.0976314 8.31658 0.292893 8.70711L6.65686 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711C8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8L8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107 0.928933C7.68054 0.538409 7.04738 0.538409 6.65685 0.928933L0.292892 7.29289ZM19 7L1 7L1 9L19 9L19 7Z" fill="black"></path>
								</svg>
							</span>
						</a>
					</li>
				{% endif %}
			</ul>
		</nav>
	</div>
</div>
