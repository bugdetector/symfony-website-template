<div class="card bg-base-100 shadow-md h-full flex flex-col">
	<figure class="h-48 overflow-hidden">
		<img class="w-full h-full object-cover" loading="lazy" alt="{{ page.title }}" src="{{ page.coverImage ? upload_asset(page.coverImage.filePath) : '/assets/logo.png' }}" />
	</figure>
	<div class="card-body flex flex-col justify-between p-4">
		{% if page.contentType.id != 4 %}
			<span class="badge badge-outline badge-sm mb-2">{{ page.createdAt|format_datetime('full', 'none') }}</span>
		{% endif %}
		<h2 class="card-title text-lg font-semibold mb-1">{{ page.title }}</h2>
		{% if page.shortDescription %}
			<p class="text-base-content/80 mb-2">{{ page.shortDescription }}...</p>
		{% endif %}
		{% if page.contentType.slug == 'static-page' %}
			{% set pageLink = path('app_page_static_view', {'slug': page.slug}) %}
		{% else %}
			{% set pageLink = path('app_page_view', {contentTypeSlug: page.contentType.slug, 'slug': page.slug}) %}
		{% endif %}
		<a href="{{ pageLink }}" class="btn btn-primary btn-sm mt-auto flex items-center gap-2 w-max">
			<span>{% trans %}Details{% endtrans %}</span>
			<i class="i-tabler-chevron-right"></i>
		</a>
	</div>
</div>
