<nav class="navbar bg-base-100 border-b border-base-300 px-4 sticky top-0 z-10" id="header">
	<div class="navbar-start">
		<label for="app-drawer" class="btn btn-ghost btn-sm drawer-button" aria-label="open sidebar">
			<span class="i-tabler-menu text-2xl"></span>
		</label>
		<div class="flex-1">
			<a href="{{ path('homepage') }}" class="flex items-center gap-2" data-turbo="false">
				<img class="dark:hidden h-[40px]" src="{{ asset('assets/logo.png') }}" alt="{{ app_name }}"/>
				<img class="hidden dark:block h-[40px]" src="{{ asset('assets/logo-dark.png') }}" alt="{{ app_name }}"/>
				{% block app_name %}
					<h2 class="text-lg font-semibold invisible">{{ app_name }}</h2>
				{% endblock %}
			</a>
		</div>
	</div>
	<div class="navbar-end">
		<div class="flex-none flex items-center gap-4">
			<div class="dropdown dropdown-end">
				<div tabindex="0" role="button" class="btn btn-ghost">
					<div class="avatar">
						<div class="w-8 rounded-full">
							{% if app.user and app.user.profilePhoto %}
								<img alt="{{ app.user.name }}" src="{{ upload_asset(app.user.profilePhoto.filePath) }}"/>
							{% else %}
								<span class='i-tabler-user text-3xl'></span>
							{% endif %}
						</div>
					</div>
					<span class="font-medium max-w-24 truncate hidden md:block">{{ app.user ? app.user.name : 'Account'|trans }}</span>
					<span class="i-tabler-chevron-down text-lg"></span>
				</div>
				<div tabindex="0" class="dropdown-content bg-base-100 rounded-box z-1 w-72 p-2 shadow-sm border border-base-200">
					{% if app.user %}
						<ul class="menu w-full p-0">
							<li>
								<a href="{{ path('app_profile') }}" data-turbo-frame="base-content">{% trans %}Profile{% endtrans %}</a>
							</li>
						</ul>
					{% endif %}
					<div class="px-2 py-2 space-y-3">
						<div>
							<div class="text-[11px] font-semibold uppercase tracking-wider text-base-content/50 px-1 mb-1.5">
								{% trans %}Theme{% endtrans %}
							</div>
							<div class="grid grid-cols-3 rounded-full bg-base-200/70 border border-base-300 p-1 gap-1">
								<label class="cursor-pointer">
									<input type="radio" name="theme" value="light" class="sr-only peer"/>
									<span class="flex items-center justify-center gap-1 whitespace-nowrap text-xs font-semibold py-1.5 px-2 rounded-full transition-colors peer-not-checked:text-base-content/80 peer-not-checked:hover:text-base-content peer-checked:bg-neutral peer-checked:text-neutral-content peer-checked:shadow-xs">
										<span class="i-tabler-sun text-sm shrink-0"></span>
										<span>{% trans %}Light{% endtrans %}</span>
									</span>
								</label>
								<label class="cursor-pointer">
									<input type="radio" name="theme" value="dark" class="sr-only peer"/>
									<span class="flex items-center justify-center gap-1 whitespace-nowrap text-xs font-semibold py-1.5 px-2 rounded-full transition-colors peer-not-checked:text-base-content/80 peer-not-checked:hover:text-base-content peer-checked:bg-neutral peer-checked:text-neutral-content peer-checked:shadow-xs">
										<span class="i-tabler-moon text-sm shrink-0"></span>
										<span>{% trans %}Dark{% endtrans %}</span>
									</span>
								</label>
								<label class="cursor-pointer">
									<input type="radio" name="theme" value="system" class="sr-only peer"/>
									<span class="flex items-center justify-center gap-1 whitespace-nowrap text-xs font-semibold py-1.5 px-2 rounded-full transition-colors peer-not-checked:text-base-content/80 peer-not-checked:hover:text-base-content peer-checked:bg-neutral peer-checked:text-neutral-content peer-checked:shadow-xs">
										<span class="i-tabler-device-desktop text-sm shrink-0"></span>
										<span>{% trans %}System{% endtrans %}</span>
									</span>
								</label>
							</div>
						</div>
						<div>
							<div class="text-[11px] font-semibold uppercase tracking-wider text-base-content/50 px-1 mb-1.5">
								{% trans %}Language{% endtrans %}
							</div>
							<div class="grid grid-flow-col auto-cols-fr rounded-full bg-base-200/70 border border-base-300 p-1 gap-1">
								{% for locale in locales() %}
									{% set is_active = app.request.locale == locale.code %}
									<a class="block text-center text-xs font-semibold py-1.5 px-2 rounded-full transition-colors {{ is_active ? 'bg-neutral text-neutral-content shadow-xs' : 'text-base-content/80 hover:text-base-content' }}" translate="no" lang="{{ locale.code }}" hreflang="{{ locale.code }}" href="?_locale={{ locale.code }}" data-turbo="false">
										{{ locale.code|upper }}
									</a>
								{% endfor %}
							</div>
						</div>
					</div>
					<div class="border-t border-base-300 my-1"></div>
					<ul class="menu w-full p-0">
						{% if app.user %}
							<li>
								<a class="text-primary" href="{{ is_granted('IS_IMPERSONATOR') ? impersonation_exit_path(path('homepage')) : path('app_logout') }}" data-turbo="false">
									{% trans %}Logout{% endtrans %}
								</a>
							</li>
						{% else %}
							<li>
								<a class="text-primary" href="{{ path('app_login') }}" data-turbo="false">
									{% trans %}Login{% endtrans %}
								</a>
							</li>
							<li>
								<a class="text-primary" href="{{ path('app_register') }}" data-turbo="false">
									{% trans %}Register{% endtrans %}
								</a>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</div>
	</div>
</nav>
